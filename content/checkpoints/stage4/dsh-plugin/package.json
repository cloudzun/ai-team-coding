{
  "name": "@local/dsh-homestay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read-only homestay tools (compare / trend / communities / ask) over HTTP (127.0.0.1:8801), each with a Web chart card.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "peerDependencies": {
    "@deepseek-ai/dsh-error": "*"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-tool"]
    }
  }
}
